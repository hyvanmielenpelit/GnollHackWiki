<search>
  <form class="search-form" action="{{search_path}}" method="get" id="search-form">
    <label for="search-query" class="sr-only">Search GnollHack Wiki</label>
    <input type="search" class="form-control input-block input-sm" name="q" id="search-query"
           value="{{query_value}}" placeholder="Search GnollHack Wiki" maxlength="200"
           autocomplete="off" autocorrect="off" autocapitalize="none" spellcheck="false"
           enterkeyhint="search">
  </form>
</search>
